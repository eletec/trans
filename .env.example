# Variables d'environnement pour Easy Packing
# Copier ce fichier en .env et remplir les valeurs

# Domaine de l'application
# Utiliser le hostname OVH par défaut, ou votre propre domaine si vous en avez un
# Ex: easypacking.mondomaine.fr  ou  vps-8b39cecf.vps.ovh.net
DOMAIN=vps-8b39cecf.vps.ovh.net

# Clé secrète JWT — générer avec : openssl rand -hex 32
JWT_SECRET=changez-moi-en-production

# Email pour les certificats Let's Encrypt (fichier .env.traefik)
# ACME_EMAIL=admin@example.com
